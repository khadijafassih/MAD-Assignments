<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_gradient_splash">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_logo"
        android:padding="20dp"
        android:background="@drawable/bg_logo_circle"
        android:elevation="8dp"/>

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EventMOS"
        android:textSize="40sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:text="Welcome to the Event Management App"
        android:textSize="14sp"
        android:textColor="#CCE8F4FF"
        android:textAlignment="center"
        android:layout_marginTop="10dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="180dp"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:progressTint="#FFFFFF"
        android:progressBackgroundTint="#44FFFFFF"
        android:layout_marginTop="48dp"/>

</LinearLayout>